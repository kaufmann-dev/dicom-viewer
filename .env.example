# PostgreSQL (local development values match the Podman command in README.md)
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="dicom_viewer"
DATABASE_URL="postgres://postgres:postgres@localhost:5432/dicom_viewer"

# Directory for uploaded DICOM and STL files
DATA_DIR="./data"

# Public origin of the app
ORIGIN="http://localhost:5173"
BETTER_AUTH_URL="http://localhost:5173"
# At least 32 random characters, e.g. `openssl rand -base64 32`
BETTER_AUTH_SECRET=""

# OIDC admin login
OIDC_DISCOVERY_URL="https://id.example.com/.well-known/openid-configuration"
OIDC_CLIENT_ID=""
OIDC_CLIENT_SECRET=""

# adapter-node request body limit; must exceed the largest uploaded file
BODY_SIZE_LIMIT="1G"
